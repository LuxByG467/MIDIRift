<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MIDIRift.BottomNavBar">

    <!-- Dos botones grandes, fijos, siempre visibles — inspirado en la
         barra inferior de Spotify pero con solo dos destinos, adaptado a
         MIDIRift. Se embebe como fila final del Grid raíz de cada pantalla
         (MainPage.xaml / LibraryPage.xaml) en vez de vivir en un Shell
         TabBar nativo, para tener control total del estilo y del
         comportamiento de "tocar la pantalla donde ya estoy". -->
    <Grid ColumnDefinitions="*,*"
          ColumnSpacing="1"
          BackgroundColor="{DynamicResource CardBackground}">

        <Button x:Name="LibraryButton"
                Grid.Column="0"
                Text="📚  Biblioteca"
                Clicked="OnLibraryClicked"
                BackgroundColor="{DynamicResource SurfaceBackground}"
                FontSize="14"
                CornerRadius="0"
                HeightRequest="58" />

        <Button x:Name="NowPlayingButton"
                Grid.Column="1"
                Text="🎵  Reproduciendo ahora"
                Clicked="OnNowPlayingClicked"
                BackgroundColor="{DynamicResource SurfaceBackground}"
                FontSize="14"
                CornerRadius="0"
                HeightRequest="58" />
    </Grid>

</ContentView>
