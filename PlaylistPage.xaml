<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MIDIRift"
             x:Class="MIDIRift.PlaylistPage"
             Title="Playlists"
             BackgroundColor="{DynamicResource PageBackground}">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Padding="16,12">

        <!-- ── Selector de playlist ────────────────────────────────────── -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
            <Picker x:Name="PlaylistPicker"
                    Grid.Column="0"
                    Title="Elegí una playlist"
                    TitleColor="{DynamicResource TextSubtle}"
                    TextColor="{DynamicResource TextPrimary}"
                    BackgroundColor="{DynamicResource CardBackground}"
                    SelectedIndexChanged="OnPlaylistPickerChanged" />

            <Button x:Name="ScanButton"
                    Grid.Column="1"
                    Text="⌕"
                    Clicked="OnScanClicked"
                    BackgroundColor="{DynamicResource ControlBackground}"
                    TextColor="{DynamicResource TextSecondary}"
                    FontSize="16"
                    WidthRequest="44" />

            <Button Grid.Column="2"
                    Text="➕"
                    Clicked="OnCreatePlaylistClicked"
                    BackgroundColor="{DynamicResource ControlBackground}"
                    TextColor="{DynamicResource TextSecondary}"
                    FontSize="16"
                    WidthRequest="44" />

            <Button Grid.Column="3"
                    Text="🗑"
                    Clicked="OnDeletePlaylistClicked"
                    BackgroundColor="{DynamicResource ControlBackground}"
                    TextColor="{DynamicResource TextSecondary}"
                    FontSize="16"
                    WidthRequest="44" />
        </Grid>

        <!-- ── Info de la playlist activa ──────────────────────────────── -->
        <Label x:Name="PlaylistInfoLabel"
               Grid.Row="1"
               Text=""
               FontSize="11"
               TextColor="{DynamicResource TextSubtle}"
               Margin="4,8,4,4" />

        <!-- ── Estado del escaneo ──────────────────────────────────────── -->
        <Grid x:Name="ScanStatusPanel"
              Grid.Row="2"
              IsVisible="False"
              ColumnDefinitions="Auto,*"
              ColumnSpacing="8"
              Margin="4,0,4,8">
            <ActivityIndicator x:Name="ScanActivityIndicator"
                                Grid.Column="0"
                                IsRunning="False"
                                Color="{DynamicResource PurpleAccent}"
                                WidthRequest="18"
                                HeightRequest="18"
                                VerticalOptions="Center" />
            <Label x:Name="ScanStatusLabel"
                   Grid.Column="1"
                   Text=""
                   FontSize="11"
                   TextColor="{DynamicResource PurpleAccent}"
                   VerticalOptions="Center"
                   LineBreakMode="MiddleTruncation" />
        </Grid>

        <!-- ── Entradas ─────────────────────────────────────────────────── -->
        <CollectionView x:Name="EntriesView"
                         Grid.Row="3"
                         SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:PlaylistEntryRow">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Padding="8,10" ColumnSpacing="8">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnEntryTapped" CommandParameter="{Binding}" />
                        </Grid.GestureRecognizers>

                        <Label Grid.Column="0"
                               Text="{Binding IsPlayingIcon}"
                               FontSize="14"
                               TextColor="{DynamicResource GreenPrimary}"
                               WidthRequest="20"
                               VerticalOptions="Center" />

                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="{Binding Title}"
                                   FontSize="14"
                                   TextColor="{DynamicResource TextPrimary}"
                                   LineBreakMode="MiddleTruncation" />
                            <Label Text="{Binding Subtitle}"
                                   FontSize="11"
                                   TextColor="{DynamicResource TextSubtle}" />
                        </VerticalStackLayout>

                        <Button Grid.Column="2"
                                Text="⭐"
                                Opacity="{Binding FavoriteOpacity}"
                                Clicked="OnFavoriteClicked"
                                CommandParameter="{Binding}"
                                BackgroundColor="Transparent"
                                TextColor="{DynamicResource Warning}"
                                FontSize="14"
                                Padding="4,0"
                                WidthRequest="36" />

                        <Button Grid.Column="3"
                                Text="✕"
                                IsVisible="{Binding CanRemove}"
                                Clicked="OnRemoveClicked"
                                CommandParameter="{Binding}"
                                BackgroundColor="Transparent"
                                TextColor="{DynamicResource TextSubtle}"
                                FontSize="14"
                                Padding="4,0"
                                WidthRequest="36" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- ── Acciones ─────────────────────────────────────────────────── -->
        <Grid Grid.Row="4" ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,8,0,0">
            <Button Grid.Column="0"
                    Text="📂 Abrir archivo"
                    Clicked="OnAddFileClicked"
                    BackgroundColor="{DynamicResource PurplePrimary}"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="46" />
            <Button Grid.Column="1"
                    Text="Cerrar"
                    Clicked="OnCloseClicked"
                    BackgroundColor="{DynamicResource ControlBackground}"
                    TextColor="{DynamicResource TextSecondary}"
                    CornerRadius="10"
                    HeightRequest="46" />
        </Grid>
    </Grid>
</ContentPage>
