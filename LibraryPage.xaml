<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MIDIRift"
             x:Class="MIDIRift.LibraryPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource PageBackground}">

    <Grid x:Name="RootGrid" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto">

        <!-- ── Barra superior: nombre de biblioteca (desplegable) / buscar / crear ── -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="8"
              Padding="12,10,12,6"
              BackgroundColor="{DynamicResource SurfaceBackground}">

            <Button x:Name="LibraryNameButton"
                    Grid.Column="0"
                    Text="Toda la música  ▾"
                    Clicked="OnLibraryNameClicked"
                    BackgroundColor="{DynamicResource ControlBackground}"
                    TextColor="{DynamicResource TextPrimary}"
                    FontSize="14"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    Padding="12,0" />

            <SearchBar x:Name="SearchPlaylistBar"
                       Grid.Column="1"
                       Placeholder="Buscar playlist"
                       PlaceholderColor="{DynamicResource TextSubtle}"
                       TextColor="{DynamicResource TextPrimary}"
                       BackgroundColor="{DynamicResource CardBackground}"
                       CancelButtonColor="{DynamicResource TextMuted}"
                       TextChanged="OnSearchTextChanged" />

            <Button Grid.Column="2"
                    Text="➕"
                    Clicked="OnCreatePlaylistClicked"
                    BackgroundColor="{DynamicResource ControlBackground}"
                    TextColor="{DynamicResource TextSecondary}"
                    FontSize="16"
                    CornerRadius="10"
                    WidthRequest="44" />
        </Grid>

        <!-- ── Segunda barra: navegación normal / confirmar reordenamiento ── -->
        <Grid Grid.Row="1" BackgroundColor="{DynamicResource SurfaceBackground}">
            <Grid x:Name="NormalLibraryActions"
                  ColumnDefinitions="*,*,Auto"
                  ColumnSpacing="6"
                  Padding="12,4">

                <Button x:Name="PlaylistsTabButton"
                        Grid.Column="0"
                        Text="Playlists"
                        Clicked="OnPlaylistsTabClicked"
                        BackgroundColor="{DynamicResource PurplePrimary}"
                        TextColor="White"
                        FontSize="13"
                        CornerRadius="8"
                        HeightRequest="38" />

                <Button x:Name="AllMusicTabButton"
                        Grid.Column="1"
                        Text="Toda la música"
                        Clicked="OnAllMusicTabClicked"
                        BackgroundColor="{DynamicResource ControlBackground}"
                        TextColor="{DynamicResource TextMuted}"
                        FontSize="13"
                        CornerRadius="8"
                        HeightRequest="38" />

                <Button x:Name="ScanButton"
                        Grid.Column="2"
                        Text="⌕ Escanear"
                        Clicked="OnScanClicked"
                        BackgroundColor="{DynamicResource ControlBackground}"
                        TextColor="{DynamicResource TextSecondary}"
                        FontSize="13"
                        CornerRadius="8"
                        HeightRequest="38" />
            </Grid>

            <Grid x:Name="ReorderActions"
                  IsVisible="False"
                  ColumnDefinitions="*,*"
                  ColumnSpacing="8"
                  Padding="12,4">
                <Button Grid.Column="0"
                        Text="Cancelar"
                        Clicked="OnCancelReorderClicked"
                        BackgroundColor="{DynamicResource ControlBackground}"
                        TextColor="{DynamicResource TextSecondary}"
                        FontSize="13"
                        CornerRadius="8"
                        HeightRequest="38" />
                <Button Grid.Column="1"
                        Text="Confirmar"
                        Clicked="OnConfirmReorderClicked"
                        BackgroundColor="{DynamicResource PurplePrimary}"
                        TextColor="White"
                        FontSize="13"
                        FontAttributes="Bold"
                        CornerRadius="8"
                        HeightRequest="38" />
            </Grid>
        </Grid>

        <!-- ── Estado del escaneo (reusa el patrón de PlaylistPage) ─────────── -->
        <Grid x:Name="ScanStatusPanel"
              Grid.Row="2"
              IsVisible="False"
              ColumnDefinitions="Auto,*"
              ColumnSpacing="8"
              Margin="16,4,16,4">
            <ActivityIndicator x:Name="ScanActivityIndicator"
                                Grid.Column="0"
                                IsRunning="False"
                                Color="{DynamicResource PurpleAccent}"
                                WidthRequest="18"
                                HeightRequest="18"
                                VerticalOptions="Center" />
            <Label x:Name="ScanStatusLabel"
                   Grid.Column="1"
                   Text=""
                   FontSize="11"
                   TextColor="{DynamicResource PurpleAccent}"
                   VerticalOptions="Center"
                   LineBreakMode="MiddleTruncation" />
        </Grid>

        <!-- ── Header de detalle: solo cuando se abrió una playlist real ───── -->
        <Grid x:Name="DetailHeaderGrid"
              Grid.Row="3"
              IsVisible="False"
              ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="8"
              Padding="16,6"
              BackgroundColor="{DynamicResource PageBackground}">

            <Button Grid.Column="0"
                    Text="←"
                    Clicked="OnBackFromDetailClicked"
                    BackgroundColor="{DynamicResource ControlBackground}"
                    TextColor="{DynamicResource TextSecondary}"
                    FontSize="16"
                    CornerRadius="8"
                    WidthRequest="40"
                    HeightRequest="36" />

            <Label x:Name="DetailPlaylistNameLabel"
                   Grid.Column="1"
                   Text=""
                   FontSize="15"
                   FontAttributes="Bold"
                   TextColor="{DynamicResource TextPrimary}"
                   VerticalOptions="Center"
                   LineBreakMode="MiddleTruncation" />

            <Button x:Name="AddFileButton"
                    Grid.Column="2"
                    Text="＋"
                    AutomationProperties.Name="Administrar canciones"
                    Clicked="OnAddFileClicked"
                    BackgroundColor="{DynamicResource PurplePrimary}"
                    TextColor="White"
                    FontSize="16"
                    CornerRadius="8"
                    WidthRequest="40"
                    HeightRequest="36" />
        </Grid>

        <!-- ── Lista de playlists ───────────────────────────────────────────── -->
        <CollectionView x:Name="PlaylistsListView"
                         Grid.Row="4"
                         SelectionMode="None"
                         Margin="0,4,0,0">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:PlaylistListRow">
                    <Grid ColumnDefinitions="*,Auto" Padding="16,12" ColumnSpacing="8">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPlaylistRowTapped" CommandParameter="{Binding}" />
                        </Grid.GestureRecognizers>

                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                            <Label Text="{Binding Name}"
                                   FontSize="15"
                                   TextColor="{DynamicResource TextPrimary}"
                                   LineBreakMode="MiddleTruncation" />
                            <Label Text="{Binding Subtitle}"
                                   FontSize="11"
                                   TextColor="{DynamicResource TextSubtle}" />
                        </VerticalStackLayout>

                        <Button Grid.Column="1"
                                Text="⋮"
                                Clicked="OnPlaylistMenuClicked"
                                CommandParameter="{Binding}"
                                BackgroundColor="Transparent"
                                TextColor="{DynamicResource TextSubtle}"
                                FontSize="18"
                                Padding="8,0"
                                WidthRequest="40" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <Button Text="＋ Crear nueva playlist"
                        Clicked="OnCreatePlaylistClicked"
                        BackgroundColor="{DynamicResource CardBackground}"
                        TextColor="{DynamicResource TextSecondary}"
                        FontSize="13"
                        CornerRadius="10"
                        Margin="16,8,16,16"
                        HeightRequest="46" />
            </CollectionView.Footer>
        </CollectionView>

        <!-- ── Entradas: playlist abierta, o "Toda la música" ──────────────── -->
        <CollectionView x:Name="TrackEntriesView"
                         Grid.Row="4"
                         IsVisible="False"
                         SelectionMode="None"
                         Margin="0,4,0,0">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:PlaylistEntryRow">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Padding="12,10" ColumnSpacing="6">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTrackEntryTapped" CommandParameter="{Binding}" />
                            <DragGestureRecognizer DragStarting="OnTrackDragStarting"
                                                   DropCompleted="OnTrackDropCompleted" />
                            <DropGestureRecognizer AllowDrop="True"
                                                   Drop="OnTrackDropped" />
                        </Grid.GestureRecognizers>

                        <Grid Grid.Column="0"
                              WidthRequest="24"
                              HeightRequest="32"
                              IsVisible="{Binding IsReorderMode}"
                              VerticalOptions="Center">
                            <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                                <BoxView HeightRequest="2" WidthRequest="18" CornerRadius="1"
                                         Color="{DynamicResource PurpleLight}" />
                                <BoxView HeightRequest="2" WidthRequest="18" CornerRadius="1"
                                         Color="{DynamicResource PurpleLight}" />
                                <BoxView HeightRequest="2" WidthRequest="18" CornerRadius="1"
                                         Color="{DynamicResource PurpleLight}" />
                            </VerticalStackLayout>
                        </Grid>

                        <Label Grid.Column="0"
                               Text="{Binding IsPlayingIcon}"
                               IsVisible="{Binding ShowPlayingIcon}"
                               FontSize="14"
                               TextColor="{DynamicResource GreenPrimary}"
                               WidthRequest="20"
                               VerticalOptions="Center" />

                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="{Binding Title}"
                                   FontSize="14"
                                   TextColor="{DynamicResource TextPrimary}"
                                   LineBreakMode="MiddleTruncation" />
                            <Label Text="{Binding Subtitle}"
                                   FontSize="11"
                                   TextColor="{DynamicResource TextSubtle}" />
                        </VerticalStackLayout>

                        <Button Grid.Column="2"
                                Text="⭐"
                                IsVisible="{Binding ShowNormalActions}"
                                Opacity="{Binding FavoriteOpacity}"
                                Clicked="OnFavoriteClicked"
                                CommandParameter="{Binding}"
                                BackgroundColor="Transparent"
                                TextColor="{DynamicResource Warning}"
                                FontSize="14"
                                Padding="4,0"
                                WidthRequest="36" />

                        <Button Grid.Column="3"
                                Text="✕"
                                IsVisible="{Binding ShowRemoveAction}"
                                Clicked="OnRemoveClicked"
                                CommandParameter="{Binding}"
                                BackgroundColor="Transparent"
                                TextColor="{DynamicResource TextSubtle}"
                                FontSize="14"
                                Padding="4,0"
                                WidthRequest="36" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- ── Mini reproductor flotante ────────────────────────────────────── -->
        <Border x:Name="MiniPlayerCard"
                Grid.Row="5"
                IsVisible="False"
                BackgroundColor="{DynamicResource CardBackground}"
                Stroke="{DynamicResource BorderColor}"
                StrokeThickness="1"
                Margin="10,4"
                Padding="8"
                StrokeShape="RoundRectangle 12">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnMiniPlayerTapped" />
            </Border.GestureRecognizers>

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Border Grid.Column="0"
                        BackgroundColor="{DynamicResource PurplePrimary}"
                        StrokeThickness="0"
                        WidthRequest="42"
                        HeightRequest="42"
                        StrokeShape="RoundRectangle 8"
                        VerticalOptions="Center">
                    <Label x:Name="MiniPlayerCover"
                           Text="🎵"
                           FontSize="18"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                    <Label x:Name="MiniPlayerTitle"
                           Text="Ningún archivo seleccionado"
                           FontSize="13"
                           TextColor="{DynamicResource TextPrimary}"
                           LineBreakMode="MiddleTruncation" />
                    <Label x:Name="MiniPlayerSubtitle"
                           Text=""
                           FontSize="11"
                           TextColor="{DynamicResource TextMuted}"
                           LineBreakMode="MiddleTruncation" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- ── Navegación inferior ──────────────────────────────────────────── -->
        <local:BottomNavBar Grid.Row="6" ActiveScreen="Library" />

    </Grid>

</ContentPage>
