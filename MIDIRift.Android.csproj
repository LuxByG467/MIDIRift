<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Android-only source package. Desktop is maintained as a separate MIDIRift project. -->
		<TargetFramework>net10.0-android</TargetFramework>


		<OutputType>Exe</OutputType>
		<RootNamespace>MIDIRift</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<MauiXamlInflator>SourceGen</MauiXamlInflator>
		<ApplicationTitle>MIDIRift</ApplicationTitle>
		<ApplicationId>com.midirift.android</ApplicationId>

		<!-- Platform-facing version must be numeric; prerelease label belongs to NuGet/package metadata. -->
		<ApplicationDisplayVersion>0.14.0</ApplicationDisplayVersion>
		<ApplicationVersion>140</ApplicationVersion>
		<Version>0.14.0-alpha</Version>
		<PackageVersion>0.14.0-alpha</PackageVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />
		<MauiImage Include="Resources\Images\*" />
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="NAudio" Version="3.0.0-preview.18" />
		<PackageReference Include="NAudio.Core" Version="3.0.0-preview.18" />
		<PackageReference Include="NAudio.Midi" Version="3.0.0-preview.18" />
		<PackageReference Include="OpenTK" Version="5.0.0-pre.16" />
		<PackageReference Include="OpenTK.Audio.OpenAL" Version="5.0.0-pre.14" />
		<PackageReference Include="OpenTK.Core" Version="5.0.0-pre.16" />
		<PackageReference Include="SkiaSharp" Version="4.151.0-rc.1.1" />
		<PackageReference Include="SkiaSharp.Views" Version="4.151.0-rc.1.1" />
		<PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="4.151.0-rc.1.1" />
		<PackageReference Include="SkiaSharp.Views.Maui.Core" Version="4.151.0-rc.1.1" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
		<PackageReference Include="SkiaSharp.NativeAssets.Android" Version="4.151.0-rc.1.1" />
		<PackageReference Include="Xamarin.AndroidX.Core" Version="1.19.0.1" />
		<PackageReference Include="Xamarin.AndroidX.Core.Core.Ktx" Version="1.19.0.1" />
		<PackageReference Include="Xamarin.AndroidX.Media" Version="1.8.0.1" />
	</ItemGroup>

	<PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
		<MIDIRiftNativeDir>$(MSBuildProjectDirectory)\Platforms\Android\Native</MIDIRiftNativeDir>
		<MIDIRiftNdkDirectory Condition="'$(MIDIRiftNdkDirectory)' == '' and '$(ANDROID_NDK_HOME)' != ''">$(ANDROID_NDK_HOME)</MIDIRiftNdkDirectory>
		<MIDIRiftNdkDirectory Condition="'$(MIDIRiftNdkDirectory)' == '' and '$(ANDROID_NDK_ROOT)' != ''">$(ANDROID_NDK_ROOT)</MIDIRiftNdkDirectory>
		<MIDIRiftNdkDirectory Condition="'$(MIDIRiftNdkDirectory)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">C:\AndroidNDK</MIDIRiftNdkDirectory>
		<MIDIRiftNdkBuild Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(MIDIRiftNdkDirectory)\ndk-build.cmd</MIDIRiftNdkBuild>
		<MIDIRiftNdkBuild Condition="!$([MSBuild]::IsOSPlatform('Windows'))">$(MIDIRiftNdkDirectory)/ndk-build</MIDIRiftNdkBuild>
	</PropertyGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
		<AndroidNativeLibrary Include="Platforms\Android\Native\libs\arm64-v8a\libmidirift_rt_audio.so">
			<Abi>arm64-v8a</Abi>
		</AndroidNativeLibrary>
		<AndroidNativeLibrary Include="Platforms\Android\Native\libs\x86_64\libmidirift_rt_audio.so">
			<Abi>x86_64</Abi>
		</AndroidNativeLibrary>
	</ItemGroup>

	<Target Name="BuildMIDIRiftNativeAudio"
			Condition="'$(TargetFramework)' == 'net10.0-android'"
			BeforeTargets="Build"
			Inputs="Platforms\Android\Native\jni\midirift_rt_audio.cpp;Platforms\Android\Native\jni\Android.mk;Platforms\Android\Native\jni\Application.mk"
			Outputs="Platforms\Android\Native\libs\arm64-v8a\libmidirift_rt_audio.so;Platforms\Android\Native\libs\x86_64\libmidirift_rt_audio.so">
		<Error Condition="!Exists('$(MIDIRiftNdkBuild)')" Text="No se encontró Android NDK en '$(MIDIRiftNdkBuild)'." />
		<Exec Command="&quot;$(MIDIRiftNdkBuild)&quot; NDK_PROJECT_PATH=&quot;$(MIDIRiftNativeDir)&quot; NDK_APPLICATION_MK=&quot;$(MIDIRiftNativeDir)\jni\Application.mk&quot; APP_BUILD_SCRIPT=&quot;$(MIDIRiftNativeDir)\jni\Android.mk&quot;" />
	</Target>

</Project>
